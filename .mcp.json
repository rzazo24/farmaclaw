{
  "mcpServers": {
    "cima": {
      "command": "uv",
      "args": ["run", "--directory", ".", "python", "mcp/cima/server.py"]
    },
    "pubmed": {
      "command": "uv",
      "args": ["run", "--directory", ".", "python", "mcp/pubmed/server.py"],
      "env": {
        "NCBI_API_KEY": "${NCBI_API_KEY:-}",
        "NCBI_EMAIL": "${NCBI_EMAIL:-}"
      }
    }
  }
}
